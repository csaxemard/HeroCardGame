{
    "name": "herocardgame",
    "version": "0.1.0",
    "author": "csaxemard",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "shared"
    ],
    "scripts": {
        "dev:back": "npm run dev -w packages/back",
