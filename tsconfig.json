{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
    },
    "include": [ "src/**/*" ],
    "exclude": [ "node_modules", "dist" ]
}